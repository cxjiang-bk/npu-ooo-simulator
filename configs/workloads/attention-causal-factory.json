{
  "schema_version": 1,
  "seed": 11,
  "experiment_id": "json-causal-attention-factory",
  "workload": {
    "factory": "examples.configurable_models:build_attention_workload",
    "kwargs": {
      "batch_size": 1,
      "num_heads": 2,
      "sequence_length": 4,
      "head_dim": 4,
      "dtype": "float32"
    }
  },
  "compile": {
    "arch": "lpu-like",
    "tile_size": 4,
    "softmax_algorithm": "materialized"
  },
  "runtime": {
    "event_backend": "cycle_event",
    "policy": "dynamic_ready_queue",
    "runtime_policy": "static",
    "address_scoreboard": true
  }
}
